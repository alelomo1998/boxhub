# Process artifacts stay out, but the task->SHA ledger is committed: HANDOFF calls it
# "the only place some of this survives", and it was living on one disk, unversioned.
.superpowers/*
!.superpowers/sdd/
.superpowers/sdd/*
!.superpowers/sdd/progress.md
.DS_Store
.idea/
.impeccable/
docs/reference/
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
graphify-out/
docker/.env
# M13a Task 7: self-signed dev cert + private key for the opt-in TLS profile. Key material even
# though it's throwaway — never committed.
docker/dev-tls/
docs/design-md/
docs/design-ref/

# Angular build cache. frontend/.gitignore covers frontend/.angular/cache, but a build run
# from the repo root creates one HERE — and the repo root IS the Docker build context, which
# is how a 6.5 GB image layer happened once before.
.angular/

# Playwright output if the runner is ever invoked from the repo root instead of e2e/
test-results/
